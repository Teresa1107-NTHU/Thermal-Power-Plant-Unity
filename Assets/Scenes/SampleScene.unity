--- !u!114 &976783940
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 976783939}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 702b6fefdd2b7df4e924b461de2ef029, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  mainCamera: {fileID: 963194227}
  powerPlantController: {fileID: 929165889}
  steps:
  - title: LNG Tank
    description: Stores liquefied natural gas before it is supplied to the power
      generation system.
    cameraPoint: {fileID: 576314485}
    actionName: Gas
  - title: Heat Recovery Steam Generator
    description: Uses heat from natural gas combustion to generate steam for the
      steam turbine.
    cameraPoint: {fileID: 1933113245}
    actionName: Boiler
  - title: Steam Turbine
    description: High-pressure steam drives the turbine and converts thermal energy
      into mechanical rotation.
    cameraPoint: {fileID: 270222141}
    actionName: Steam
  - title: Chimney
    description: Exhaust gases produced during combustion are discharged through
      the chimney. Compared with coal-fired power plants, natural gas plants generate
      cleaner emissions and lower carbon dioxide output.
    cameraPoint: {fileID: 330086171}
    actionName: 
  - title: Condenser
    description: After passing through the turbine, the steam is cooled and condensed
      back into water, allowing the water cycle to continue within the power plant
      system.
    cameraPoint: {fileID: 387503371}
    actionName: Cooling
  - title: Cooling Tower
    description: The cooling tower removes excess heat from the circulating water
      system and releases water vapor into the atmosphere.
    cameraPoint: {fileID: 1966263878}
    actionName: 
  - title: Cooling Pump
    description: The cooling pump circulates cooling water between the condenser
      and cooling tower to maintain stable thermal operation.
    cameraPoint: {fileID: 23087762}
    actionName: 
  - title: Generator
    description: "The generator converts the turbine\u2019s mechanical rotational
      energy into electrical energy through electromagnetic induction."
    cameraPoint: {fileID: 183617572}
    actionName: Electricity
  - title: Transformer
    description: The transformer adjusts the electrical voltage for efficient transmission
      and distribution of electricity.
    cameraPoint: {fileID: 1839328549}
    actionName: 
  - title: Electric Load
    description: Electricity generated by the power plant is delivered to electrical
      loads. The brightness of the lightbulb changes according to the natural gas
      input level.
    cameraPoint: {fileID: 1395974731}
    actionName: Lightbulb
  - title: Natural Gas Power Plant
    description: This interactive system demonstrates the energy conversion process
      in a natural gas combined cycle power plant, including fuel supply, heat generation,
      steam circulation, cooling systems, electricity generation, and power delivery.
    cameraPoint: {fileID: 520844268}
    actionName: 
  titleText: {fileID: 810217407}
  bodyText: {fileID: 186854870}
  nextButtonText: {fileID: 1961942077}
  previousButton: {fileID: 1323175608}
  nextButton: {fileID: 493032549}
  moveDuration: 1.5
